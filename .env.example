NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./data/ecopower.sqlite
UPLOAD_DIR=./uploads
# Vercel Blob uses separate stores: private uploads and public published assets.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
ADMIN_NOTIFICATION_EMAIL=

# Production values are supplied in Vercel Project Settings, never committed:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# DATABASE_URL=postgres://...
# VERCEL_ENV=preview or production (provided automatically by Vercel)
# ECOPOWER_PREVIEW_PRIVATE_READ_WRITE_TOKEN=vercel_blob_rw_...
# ECOPOWER_PREVIEW_PUBLIC_READ_WRITE_TOKEN=vercel_blob_rw_...
# ECOPOWER_PREVIEW_PRIVATE_STORE_ID=optional-store-id-check
# ECOPOWER_PREVIEW_PUBLIC_STORE_ID=optional-store-id-check
# ECOPOWER_PRODUCTION_PRIVATE_READ_WRITE_TOKEN=vercel_blob_rw_...
# ECOPOWER_PRODUCTION_PUBLIC_READ_WRITE_TOKEN=vercel_blob_rw_...
# ECOPOWER_PRODUCTION_PRIVATE_STORE_ID=optional-store-id-check
# ECOPOWER_PRODUCTION_PUBLIC_STORE_ID=optional-store-id-check
# PG_POOL_MAX=5
# PGSSL=disable  # local PostgreSQL only; omit in Vercel
