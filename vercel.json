{
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/impact", "destination": "/impact.html" },
    { "source": "/partners", "destination": "/partners.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ]
}
